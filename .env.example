DETECT_DEVICE=cpu

# Face detector mode: cascade | yolo_face | scrfd
FACE_MODE=cascade

# YOLO face settings (used when FACE_MODE=yolo_face)
FACE_YOLO_MODEL=models/yolov8n-face.pt
FACE_PERSON_CONF=0.35

# License Plate Detection
LP_PLATE_MODEL=models/license_plate_detector.pt
LP_VEHICLE_MODEL=models/yolo11n.pt
LP_PLATE_CONF=0.20
LP_VEHICLE_CONF=0.30
