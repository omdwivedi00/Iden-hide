# ========================
# Runtime
# ========================
DETECT_DEVICE=cpu

# ========================
# Face detector mode
#   cascade   : YOLO(person) + SCRFD
#   yolo_face : YOLO(face) only
#   scrfd     : SCRFD only (full frame)
# ========================
FACE_MODE=cascade

# ========================
# YOLO (person in cascade, face in yolo_face)
# ========================
FACE_YOLO_MODEL=models/yolov8n.pt
FACE_PERSON_CONF=0.3
FACE_IMG_SIZE=640
FACE_MAX_PERSONS=25

# ========================
# YOLO-face override (used only when FACE_MODE=yolo_face)
# ========================
# You can override FACE_YOLO_MODEL before running
# e.g. FACE_YOLO_MODEL=models/yolov8l-face.pt
FACE_DET_THR=0.3

# ========================
# SCRFD (InsightFace)
# ========================
FACE_DET_SIZE=800
FACE_DET_THR=0.3
FACE_FLIP_TTA=True

# ========================
# Post-processing
# ========================
# NOTE: only used if you add it to Settings
# FACE_NMS_IOU=0.55

# ========================
# License Plate Detection
# ========================
LP_PLATE_MODEL=models/license_plate_detector.pt
LP_VEHICLE_MODEL=models/yolo11n.pt
LP_PLATE_CONF=0.20
LP_VEHICLE_CONF=0.30
